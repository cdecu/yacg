{
  "name": "yacg-cmd",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/yacg-cmd/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/yacg-cmd"],
      "defaultConfiguration": "production",
      "options": {
        "command": "vp pack",
        "cwd": "apps/yacg-cmd"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vp test apps/yacg-cmd/src/spec/config.spec.ts",
        "cwd": "."
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vp lint apps/yacg-cmd",
        "cwd": "."
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "yacg-cmd:build",
        "runBuildTargetDependencies": false
      }
    }
  }
}
