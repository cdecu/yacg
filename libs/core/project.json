{
  "name": "core",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/core/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/libs/core"],
      "options": {
        "command": "vp pack",
        "cwd": "libs/core"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vp test libs/core/src/spec/printors.spec.ts libs/core/src/spec/propInfo.spec.ts",
        "cwd": "."
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vp lint libs/core",
        "cwd": "."
      }
    }
  }
}
